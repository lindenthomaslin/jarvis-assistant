# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=medium

# 语音服务配置
# TTS 引擎：edge_tts (免费) / elevenlabs (高品质但需密钥)
TTS_ENGINE=edge_tts
TTS_VOICE=zh-CN-YunxiNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# 唤醒词配置
WAKE_WORD=jarvis
WAKE_WORD_MODEL=openwakeword
OPENWAKEWORD_MODEL_PATH=models/hey_jarvis_v0.1.onnx

# STT 配置
# tiny: 速度最快，适合低延迟场景；base: 准确度更高但稍慢
STT_MODEL_SIZE=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# 音频设备配置
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024

# WebSocket / HTTP 服务
WS_HOST=0.0.0.0
WS_PORT=18790
